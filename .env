# ==============================================================================
# DYPIU NBA Attainment Backend - Production Environment Variables
# ==============================================================================

# Server Configuration
SERVER_PORT=8010
SERVER_ADDRESS=0.0.0.0

# Database Configuration (PostgreSQL on Linux VM)
DATABASE_URL=jdbc:postgresql://localhost:5432/dypiu_obe_db
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=your_actual_postgres_password
DATABASE_DRIVER=org.postgresql.Driver
DB_POOL_SIZE=20

# JPA & Flyway Migration Configuration
HIBERNATE_DDL_AUTO=validate
FLYWAY_ENABLED=true

# JWT Security
JWT_SECRET=c3VwZXJfc2VjdXJlX2R5cGl1X25iYV9hdHRhaW5tZW50X3Byb2R1Y3Rpb25fa2V5XzIwMjZfamF2YTIx
JWT_EXPIRATION_MS=86400000
JWT_REFRESH_EXPIRATION_MS=604800000

# File Upload & Storage (Mounted into container at /app/storage and /app/uploads)
LOCAL_STORAGE_PATH=/app/storage
UPLOAD_STORAGE_PATH=/app/uploads

# CORS Allowed Origins (Set your VM IP / Domain on port 3010)
CORS_ALLOWED_ORIGINS=http://10.100.0.23:3010,http://150.129.156.37:3010,http://localhost:3010
